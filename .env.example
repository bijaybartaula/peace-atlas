# Copy to .env.local and fill in. Never commit real keys.
# GEMINI_API_KEY is read server-side only (see src/lib/ai/provider.ts and app/api/ai/route.ts).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Public canonical URL used for sitemap, robots, and metadata. Set to the
# production domain when deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
